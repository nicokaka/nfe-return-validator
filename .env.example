# =============================================================================
# CONFIGURAÇÃO DE INTEGRAÇÃO COM O BANCO DE DADOS ORACLE - ERP PIRÂMIDE (PROCENGE)
# =============================================================================

# Ambiente Ativo: 'HOMOLOGACAO' (Servidor .61) ou 'PRODUCAO' (Servidor .60)
ORACLE_ENVIRONMENT=HOMOLOGACAO

# Credenciais de Acesso ao Banco Oracle
# (Geralmente o usuário do schema do ERP Pirâmide, ex: PIRAMIDE)
ORACLE_USER=PIRAMIDE
ORACLE_PASSWORD=sua_senha_aqui

# Endereço de Conexão (Connect String)
# Homologação Hebron (.61): 192.169.97.61:1521/TESTE
# Produção Hebron (.60):    192.169.97.60:1521/PIRAMIDE (ou SERVICE_NAME de produção)
ORACLE_CONNECT_STRING=192.169.97.61:1521/TESTE

# Código Oficial do Sistema Integrante na tabela TI_SISTEMA
ORACLE_SISTEMA_ORIGEM=VAL

# Pool de Conexões e Timeout (Thin Mode nativo do Node.js)
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4
ORACLE_TIMEOUT_MS=15000

# Polling de Atualização de Status da TI (em milissegundos)
VITE_PIRAMIDE_POLL_INTERVAL=15000
